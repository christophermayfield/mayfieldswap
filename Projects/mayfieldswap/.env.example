# Copy this file to .env and fill in your values
# Never commit .env to git

# Your deployer wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Base Sepolia RPC URL — public endpoint works, or use Alchemy/Infura for reliability
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Basescan API key for contract verification (get from https://basescan.org/myapikey)
BASESCAN_API_KEY=your_basescan_api_key_here

# WalletConnect project ID for the frontend (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
